# Local sin Docker (Node.js 24+)
PORT=3000
FRONTEND_URL=http://localhost:4200
DATABASE_URL=file:./data/suma.db
SEED_DEMO=true
ENABLE_DEV_RESET_LINK=true
NODE_ENV=development
# PostgreSQL: DATABASE_URL=postgresql://prg:prg_dev@localhost:5433/prg
# Recuperación por correo (Mailpit del docker-compose):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=SUMA <no-reply@suma.ec>

# 32 bytes aleatorios (64 caracteres hexadecimales). Obligatoria en producción.
SUMA_DATA_KEY=

# Usa 1 solo cuando el backend esté detrás de un único proxy confiable sin acceso directo.
TRUST_PROXY=0

# Sprint 2. Publica la versión numerada y ambos textos aprobados antes de habilitar altas reales.
SUMA_AVISO_VERSION=
SUMA_TERMINOS=
SUMA_PRIVACIDAD=
