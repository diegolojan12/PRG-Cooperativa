# SUMA trabaja únicamente con PostgreSQL (versión 14 o superior). Node.js 24+.
PORT=3000
# Dirección exacta desde la que el navegador abre la web (protocolo + equipo + puerto).
# En un laboratorio con dos PC: http://IP_DEL_FRONTEND:4200
FRONTEND_URL=http://localhost:4200
DATABASE_URL=postgresql://suma:suma_dev@localhost:5432/suma
SEED_DEMO=true
ENABLE_DEV_RESET_LINK=true
NODE_ENV=development

# Para crear el usuario y la base con `npm run db:crear` (cuenta administradora de PostgreSQL):
# PGADMIN_URL=postgresql://postgres:TU_CLAVE@localhost:5432/postgres

# Correo: 2FA, recuperacion, activacion, registro y cambio de correo.
# Guia: docs/CORREO-TRANSACCIONAL.md. Un solo remitente sirve para cualquier destinatario.
# Opcional en desarrollo:
# con ENABLE_DEV_RESET_LINK=true el código y el enlace se muestran en pantalla.
# Gmail (desarrollo): usa una contrasena de aplicacion, no la clave habitual.
# SMTP_SERVICE=gmail
# SMTP_USER=tu-remitente@gmail.com
# SMTP_PASSWORD=CONTRASENA_DE_APLICACION
# SMTP_FROM=SUMA <tu-remitente@gmail.com>
# Otros: SMTP_SERVICE=microsoft365 o yahoo (segun autenticacion habilitada por el proveedor).
# Un servidor personalizado usa SMTP_HOST en lugar de SMTP_SERVICE:
# SMTP_HOST=smtp.tu-servidor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# OAuth2 con token emitido/renovado externamente (por ejemplo Microsoft 365):
# SMTP_AUTH_TYPE=oauth2
# SMTP_ACCESS_TOKEN=

# 32 bytes aleatorios (64 caracteres hexadecimales). Obligatoria en producción.
SUMA_DATA_KEY=

# Usa 1 solo cuando el backend esté detrás de un único proxy confiable (como el servidor del frontend en el laboratorio).
TRUST_PROXY=0

# Sprint 2. Publica la versión numerada y ambos textos aprobados antes de habilitar altas reales.
SUMA_AVISO_VERSION=
SUMA_TERMINOS=
SUMA_PRIVACIDAD=
