// Esquema de referencia de SUMA, generado con `npx prisma db pull --config prisma7.config.ts`.
// La fuente de verdad son las migraciones SQL de prisma/*.sql que aplica Database.init();
// la API usa SQL directo (src/database.mjs). Regenera este archivo después de cada migración.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Usuario {
  id                                      Int                  @id @default(autoincrement())
  cedula                                  String?              @unique
  correo                                  String               @unique
  nombre                                  String
  rol                                     String               @default("SOCIO")
  creadoEn                                DateTime             @default(now())
  passwordHash                            String?
  celular                                 String?
  activo                                  Boolean              @default(true)
  cuenta                                  String?
  tipoCuenta                              String?
  intentosFallidos                        Int                  @default(0)
  bloqueadoHasta                          String?
  cuentaEstado                            String?
  correoIndice                            String?
  codigoReferido                          String?              @unique(map: "usuario_codigo_referido")
  cuentaIndice                            String?
  cuentaSolicitadaEn                      String?
  cuentaRevisadaEn                        String?
  correoVerificado                        Boolean              @default(true)
  celularIndice                           String?
  provincia                               String?
  perfilPublico                           Boolean              @default(false)
  bajaEn                                  String?
  bajaMotivo                              String?
  AceptacionTerminos                      AceptacionTerminos[]
  Actividad                               Actividad[]
  AvisoPrivacidad                         AvisoPrivacidad[]
  CambioCorreo                            CambioCorreo?
  ConfirmacionCorreo                      ConfirmacionCorreo?
  DosFactor                               DosFactor[]
  MovimientoPuntos                        MovimientoPuntos[]
  Notificacion                            Notificacion[]
  Recuperacion                            Recuperacion[]
  Referido_Referido_eliminadoPorToUsuario Referido[]           @relation("Referido_eliminadoPorToUsuario")
  Referido_Referido_socioIdToUsuario      Referido[]           @relation("Referido_socioIdToUsuario")
  Referido_Referido_usuarioIdToUsuario    Referido[]           @relation("Referido_usuarioIdToUsuario")
  Sesion                                  Sesion[]
}

model RolPermiso {
  rol     String @id
  modulos String
}

model Sesion {
  token     String  @id
  usuarioId Int
  expira    String
  Usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Recuperacion {
  token     String  @id
  usuarioId Int
  expira    String
  Usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Referido {
  id                                     Int                @id @default(autoincrement())
  nombre                                 String
  correo                                 String             @unique(map: "referido_correo_activo", where: raw("(\"eliminadoEn\" IS NULL)"))
  celular                                String
  estado                                 String             @default("PENDIENTE")
  socioId                                Int
  creadoEn                               String
  notas                                  String?            @default("")
  eliminadoEn                            String?
  eliminadoPor                           Int?
  motivoBaja                             String?
  usuarioId                              Int?
  fechaDecision                          String?
  campania                               String?
  provincia                              String?
  correoIndice                           String?
  MovimientoPuntos                       MovimientoPuntos[]
  Usuario_Referido_eliminadoPorToUsuario Usuario?           @relation("Referido_eliminadoPorToUsuario", fields: [eliminadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Usuario_Referido_socioIdToUsuario      Usuario            @relation("Referido_socioIdToUsuario", fields: [socioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Usuario_Referido_usuarioIdToUsuario    Usuario?           @relation("Referido_usuarioIdToUsuario", fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([socioId])
}

model Actividad {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  actor      String
  accion     String
  detalle    String
  fecha      String
  ip         String?
  objetivoId Int?
  datos      String?
  Usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha])
}

model Notificacion {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  titulo    String
  mensaje   String
  leida     Boolean @default(false)
  fecha     String
  Usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuarioId, id], map: "notificacion_destinatario")
}

model Configuracion {
  clave String @id
  valor String
}

model AceptacionTerminos {
  usuarioId       Int
  version         String
  fecha           String
  Usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AvisoPrivacidad AvisoPrivacidad @relation(fields: [version], references: [version], onDelete: NoAction, onUpdate: NoAction)

  @@id([usuarioId, version])
}

model AvisoPrivacidad {
  version            String               @id
  terminos           String
  privacidad         String
  vigente            Boolean              @unique(map: "aviso_privacidad_un_vigente", where: raw("vigente")) @default(false)
  publicadoEn        String?
  publicadoPor       Int?
  AceptacionTerminos AceptacionTerminos[]
  Usuario            Usuario?             @relation(fields: [publicadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// HU-055: correo nuevo pendiente de confirmar con código.
model CambioCorreo {
  usuarioId    Int     @id
  correo       String
  correoIndice String?
  huella       String
  vence        String
  intentos     Int     @default(0)
  Usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ConfirmacionCorreo {
  usuarioId   Int     @id
  token       String  @unique
  tokenExpira String
  huella      String
  vence       String
  intentos    Int     @default(0)
  reenvios    String  @default("[]")
  Usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model DosFactor {
  id        String  @id
  usuarioId Int
  codigo    String
  expira    String
  intentos  Int     @default(0)
  Usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Modulo {
  clave      String  @id
  etiqueta   String
  grupo      String
  icono      String
  orden      Int
  ambito     String  @default("COMUN")
  disponible Boolean @default(true)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MovimientoPuntos {
  referidoId Int?
  usuarioId  Int
  cantidad   Int
  fecha      String
  clave      String    @id
  actividad  String
  Referido   Referido? @relation(fields: [referidoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuarioId], map: "movimiento_usuario")
}

model Rol {
  clave                 String  @id
  nombre                String
  descripcion           String  @default("")
  sistema               Boolean @default(false)
  requiereSegundoFactor Boolean @default(false)
  alcanceGlobal         Boolean @default(false)
  interfaz              String  @default("COMUNIDAD")
  disponibles           String  @default("[]")
  obligatorios          String  @default("[]")
  creadoEn              String?
}

model SumaMigracion {
  nombre String @id
}
