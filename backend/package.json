{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "npm run test:sprint && npm run test:correo",
    "db:crear": "node --env-file=.env scripts/crear-bd.mjs",
    "db:init": "node --env-file=.env scripts/database.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:respaldo": "node --env-file=.env scripts/respaldo.mjs",
    "start:local": "node --env-file=.env dist/main.js",
    "test:sprint": "node --env-file-if-exists=.env --test test/sprint.test.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "admin:email": "node --env-file-if-exists=.env scripts/admin-email.mjs",
    "mail:verify": "node --env-file-if-exists=.env scripts/verificar-correo.mjs",
    "test:correo": "node --env-file-if-exists=.env --test test/correo.test.mjs test/correo-integracion.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
